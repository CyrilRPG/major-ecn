# =============================================================================
# Major ECN — Configuration .env
# =============================================================================
# Copie ce fichier en .env.local et remplis avec tes vraies valeurs.
# Ne commit JAMAIS .env.local — il est dans .gitignore.

# ------------------------------------------------------------
# Site
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase (DB + Auth)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Service role key — JAMAIS exposer côté client. Utilisée pour créer des users
# auth, écrire dans les tables protégées par RLS, provisionner les comptes après
# achat Stripe, etc.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ------------------------------------------------------------
# Stripe — Mode TEST par défaut (clés sk_test_... / pk_test_...)
# ------------------------------------------------------------
# Récupère tes clés sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_SK_TEST_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_PK_TEST_KEY

# Endpoint webhook : Crée un endpoint pointant vers
#   https://<ton-domaine>/api/stripe/webhook
# Active uniquement l'événement `checkout.session.completed`. Copie le
# "Signing secret" ici.
# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WHSEC_KEY

# IDs des prix Stripe (mode test). Crée-les via le dashboard Stripe
# (Produit + Prix) et colle leurs `price_id` ici. Voir docs/stripe-setup.md
STRIPE_PRICE_ESSENTIELLE=REPLACE_WITH_PRICE_ID_FROM_STRIPE
STRIPE_PRICE_INTENSIVE=REPLACE_WITH_PRICE_ID_FROM_STRIPE
STRIPE_PRICE_PROGRAMME=REPLACE_WITH_PRICE_ID_FROM_STRIPE

# ------------------------------------------------------------
# Email (Resend — optionnel mais recommandé pour la prod)
# ------------------------------------------------------------
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
EMAIL_FROM="Major ECN <contact@major-ecn.fr>"
EMAIL_REPLY_TO=contact@major-ecn.fr
