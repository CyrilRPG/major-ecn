{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/campaign-drip",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/exams-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/relance-inactifs",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/stripe-reconcile",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pedagogical-alerts",
      "schedule": "0 7 * * *"
    }
  ]
}
