NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_jwt...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL publique du site (utilisée par les emails transactionnels :
# activation, mot de passe oublié, etc.). En production, MUST être
# https://major-ecn.fr — sinon les liens d'email pointent sur
# localhost ou sur l'URL Vercel. Prioritaire sur les fallbacks Vercel.
NEXT_PUBLIC_SITE_URL=https://major-ecn.fr

# Resend — envoi des emails transactionnels (activation, reset password).
RESEND_API_KEY=re_xxx
# Optionnel : adresse d'expédition (par défaut sandbox Resend).
EMAIL_FROM=Major ECN <noreply@major-ecn.fr>

# IA — assistant Q&R et génération de contenu admin.
# Obligatoire en production. Sans cette clé, l'assistant des cours
# renvoie un message d'erreur et l'admin ne peut pas générer de QCM/flashcards.
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Embeddings (optionnel — fallback en recherche par mots-clés si absent).
VOYAGE_API_KEY=pa-xxx
